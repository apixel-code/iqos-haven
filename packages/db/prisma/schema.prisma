// Business tables are introduced in roadmap order; no invented foundation tables.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Append-only audit trail (roadmap step 18). UPDATE/DELETE/TRUNCATE are rejected by trigger.
/// actor_id has no FK yet: staff_users arrives in step 27.
model AuditLog {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  occurredAt DateTime @default(dbgenerated("statement_timestamp()")) @map("occurred_at") @db.Timestamptz(6)
  actorType  String   @map("actor_type") @db.VarChar(16)
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(64)
  entityType String   @map("entity_type") @db.VarChar(64)
  entityId   String   @map("entity_id") @db.VarChar(128)
  requestId  String   @map("request_id") @db.VarChar(128)
  commandId  String?  @map("command_id") @db.VarChar(128)
  reason     String?  @db.VarChar(500)
  diff       Json     @default("{}")

  @@index([entityType, entityId, occurredAt(sort: Desc)])
  @@index([actorId, occurredAt(sort: Desc)])
  @@index([occurredAt(sort: Desc)])
  @@map("audit_log")
}

/// Transactional outbox (roadmap step 19). One row per committed domain event; payload carries IDs only.
/// Relay lease/dispatch columns are hints; completion is decided by consumer_effects.
model OutboxEvent {
  id               String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventType        String           @map("event_type") @db.VarChar(64)
  schemaVersion    Int              @map("schema_version")
  aggregateType    String           @map("aggregate_type") @db.VarChar(64)
  aggregateId      String           @map("aggregate_id") @db.VarChar(128)
  aggregateVersion BigInt?          @map("aggregate_version")
  payload          Json             @default("{}")
  createdAt        DateTime         @default(dbgenerated("statement_timestamp()")) @map("created_at") @db.Timestamptz(6)
  leaseOwner       String?          @map("lease_owner") @db.VarChar(128)
  leaseExpiresAt   DateTime?        @map("lease_expires_at") @db.Timestamptz(6)
  dispatchAttempts Int              @default(0) @map("dispatch_attempts")
  lastError        String?          @map("last_error") @db.VarChar(500)
  dispatchedAt     DateTime?        @map("dispatched_at") @db.Timestamptz(6)
  completedAt      DateTime?        @map("completed_at") @db.Timestamptz(6)
  effects          ConsumerEffect[]

  @@index([aggregateType, aggregateId, createdAt])
  @@map("outbox_events")
}

/// One required effect per (event, consumer), snapshotted when the event is written.
/// status: pending | queued | running | retry | completed | dead | skipped.
model ConsumerEffect {
  id              String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventId         String      @map("event_id") @db.Uuid
  event           OutboxEvent @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  consumer        String      @db.VarChar(64)
  /// Opaque reference (e.g. a recipient/staff UUID) for consumer fan-out. Never personal data.
  payloadRef      String?     @map("payload_ref") @db.VarChar(256)
  status          String      @default("pending") @db.VarChar(16)
  attempts        Int         @default(0)
  leaseOwner      String?     @map("lease_owner") @db.VarChar(128)
  leaseExpiresAt  DateTime?   @map("lease_expires_at") @db.Timestamptz(6)
  heartbeatAt     DateTime?   @map("heartbeat_at") @db.Timestamptz(6)
  queuedAt        DateTime?   @map("queued_at") @db.Timestamptz(6)
  replays         Int         @default(0)
  dueAt           DateTime    @default(dbgenerated("statement_timestamp()")) @map("due_at") @db.Timestamptz(6)
  createdAt       DateTime    @default(dbgenerated("statement_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @default(dbgenerated("statement_timestamp()")) @map("updated_at") @db.Timestamptz(6)
  completedAt     DateTime?   @map("completed_at") @db.Timestamptz(6)
  lastError       String?     @map("last_error") @db.VarChar(500)
  externalReceipt String?     @map("external_receipt") @db.VarChar(256)
  skipReason      String?     @map("skip_reason") @db.VarChar(500)

  @@unique([eventId, consumer])
  @@map("consumer_effects")
}

/// Durable schedule slots (roadmap step 24). One row per (job, slot) across all worker replicas;
/// missed slots inside a job's catch-up window are created and run after downtime.
/// status: pending | running | completed | failed.
model ScheduledRun {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  jobName        String    @map("job_name") @db.VarChar(64)
  slot           DateTime  @db.Timestamptz(6)
  status         String    @default("pending") @db.VarChar(16)
  attempts       Int       @default(0)
  leaseOwner     String?   @map("lease_owner") @db.VarChar(128)
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  lastError      String?   @map("last_error") @db.VarChar(120)
  createdAt      DateTime  @default(dbgenerated("statement_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(dbgenerated("statement_timestamp()")) @map("updated_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)

  @@unique([jobName, slot])
  @@map("scheduled_runs")
}

/// Fixed launch roles (roadmap step 27): owner, staff. Custom roles are deferred.
/// The owner row is also the common identity guard locked before Owner membership changes.
model Role {
  id          String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key         String                 @unique @db.VarChar(32)
  name        String                 @db.VarChar(64)
  createdAt   DateTime               @default(dbgenerated("statement_timestamp()")) @map("created_at") @db.Timestamptz(6)
  permissions RolePermission[]
  staff       StaffUser[]
  invitations StaffInvitationToken[]

  @@map("roles")
}

/// Granular permission keys, seeded from @ih/domain PERMISSIONS.
model Permission {
  id          String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key         String           @unique @db.VarChar(64)
  description String           @db.VarChar(200)
  roles       RolePermission[]

  @@map("permissions")
}

/// Explicit grants only; no wildcard.
model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Admin users. Never deleted (deactivate). Email stored normalized (trimmed, lower case).
model StaffUser {
  settingsUpdates     Setting[]
  deliveryAreaUpdates DeliveryArea[]
  couponUpdates       Coupon[]
  notificationReceipts NotificationReceipt[]
  ordersCreated       Order[]              @relation("OrderCreatedBy")
  ordersCollected     Order[]              @relation("OrderCollectedBy")
  orderStatusChanges  OrderStatusHistory[]
  stockMovements      StockMovement[]
  mediaUploads        MediaAsset[]
  id                  String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email               String                 @unique @db.VarChar(254)
  passwordHash        String                 @map("password_hash") @db.VarChar(255)
  name                String                 @db.VarChar(100)
  roleId              String                 @map("role_id") @db.Uuid
  role                Role                   @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  active              Boolean                @default(true)
  /// Deferred MFA: encrypted TOTP secret only, never plaintext.
  totpSecretEncrypted Bytes?                 @map("totp_secret_encrypted")
  lastActiveAt        DateTime?              @map("last_active_at") @db.Timestamptz(6)
  createdAt           DateTime               @default(dbgenerated("statement_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime               @default(dbgenerated("statement_timestamp()")) @map("updated_at") @db.Timestamptz(6)
  version             Int                    @default(1)
  sessions            Session[]
  passwordResets      PasswordResetToken[]
  invitationsSent     StaffInvitationToken[] @relation("Inviter")

  @@index([roleId])
  @@map("staff_users")
}

/// Admin sessions: only the SHA-256 of the 256-bit token is stored.
/// Idle timeout 12 h (last_seen_at), absolute expiry 7 days (expires_at).
model Session {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  user         StaffUser @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tokenHash    Bytes     @unique @map("token_hash")
  createdAt    DateTime  @default(dbgenerated("statement_timestamp()")) @map("created_at") @db.Timestamptz(6)
  lastSeenAt   DateTime  @default(dbgenerated("statement_timestamp()")) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason String?   @map("revoke_reason") @db.VarChar(32)
  /// Minimized metadata: truncated IP network and a coarse client label, never full UA strings.
  ipNetwork    String?   @map("ip_network") @db.VarChar(64)
  clientLabel  String?   @map("client_label") @db.VarChar(64)

  @@index([userId])
  @@map("sessions")
}

/// Verifier only. The worker derives the secret with a dedicated key kept outside PostgreSQL.
model PasswordResetToken {
  id            String    @id @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  user          StaffUser @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tokenHash     Bytes     @unique @map("token_hash")
  keyId         String    @map("key_id") @db.VarChar(32)
  userVersion   Int       @map("user_version")
  recipientHash Bytes     @map("recipient_hash")
  createdAt     DateTime  @default(dbgenerated("statement_timestamp()")) @map("created_at") @db.Timestamptz(6)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Immutable recipient/role snapshots; secret lives only as a hashed verifier.
model StaffInvitationToken {
  id         String    @id @db.Uuid
  email      String    @db.VarChar(254)
  name       String    @db.VarChar(100)
  roleId     String    @map("role_id") @db.Uuid
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  invitedBy  String    @map("invited_by") @db.Uuid
  inviter    StaffUser @relation("Inviter", fields: [invitedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tokenHash  Bytes     @unique @map("token_hash")
  keyId      String    @map("key_id") @db.VarChar(32)
  createdAt  DateTime  @default(dbgenerated("statement_timestamp()")) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  version    Int       @default(1)

  @@index([invitedBy])
  @@map("staff_invitation_tokens")
}

/// Versioned typed configuration; absent or JSON-null values are unconfigured (step 38).
model Setting {
  key       String    @id @db.VarChar(64)
  value     Json
  version   Int       @default(1)
  updatedBy String    @map("updated_by") @db.Uuid
  updater   StaffUser @relation(fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedAt DateTime  @default(dbgenerated("statement_timestamp()")) @map("updated_at") @db.Timestamptz(6)

  @@map("settings")
}

model DeliveryArea {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code      String    @unique @db.VarChar(64)
  name      String    @db.VarChar(100)
  emirate   String    @default("dubai") @db.VarChar(16)
  active    Boolean   @default(false)
  version   Int       @default(1)
  updatedBy String    @map("updated_by") @db.Uuid
  updater   StaffUser @relation(fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  updatedAt DateTime  @default(dbgenerated("statement_timestamp()")) @map("updated_at") @db.Timestamptz(6)
  addresses CustomerAddress[]
  orders    Order[]

  @@map("delivery_areas")
}

/// Percentage coupon (step 68). `activeRedemptions` changes only through redemptions.
model Coupon {
  id                String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code              String             @unique @db.VarChar(32)
  percentBps        Int                @map("percent_bps")
  minSubtotalFils   BigInt             @default(0) @map("min_subtotal_fils")
  startsAt          DateTime?          @map("starts_at") @db.Timestamptz(6)
  expiresAt         DateTime?          @map("expires_at") @db.Timestamptz(6)
  active            Boolean            @default(false)
  usageLimit        Int?               @map("usage_limit")
  activeRedemptions Int                @default(0) @map("active_redemptions")
  version           Int                @default(1)
  deletedAt         DateTime?          @map("deleted_at") @db.Timestamptz(6)
  updatedBy         String             @map("updated_by") @db.Uuid
  updater           StaffUser          @relation(fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdAt         DateTime           @default(dbgenerated("statement_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(dbgenerated("statement_timestamp()")) @map("updated_at") @db.Timestamptz(6)
  redemptions       CouponRedemption[]

  @@map("coupons")
}

/// What one order used; released at most once.
model CouponRedemption {
  id                      String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  couponId                String    @map("coupon_id") @db.Uuid
  coupon                  Coupon    @relation(fields: [couponId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  orderId                 String    @unique @map("order_id") @db.Uuid
  order                   Order     @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  code                    String    @db.VarChar(32)
  percentBps              Int       @map("percent_bps")
  merchandiseSubtotalFils BigInt    @map("merchandise_subtotal_fils")
  discountFils            BigInt    @map("discount_fils")
  redeemedAt              DateTime  @default(dbgenerated("statement_timestamp()")) @map("redeemed_at") @db.Timestamptz(6)
  releasedAt              DateTime? @map("released_at") @db.Timestamptz(6)

  @@index([couponId, redeemedAt(sort: Desc), id(sort: Desc)], map: "coupon_redemptions_coupon")
  @@map("coupon_redemptions")
}

/// Guest customer keyed by normalized phone (step 65). Not an account: no credentials.
model Customer {
  id           String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  phoneE164    String            @unique @map("phone_e164") @db.VarChar(16)
  displayName  String            @map("display_name") @db.VarChar(100)
  firstOrderAt DateTime?         @map("first_order_at") @db.Timestamptz(6)
  noShow       Boolean           @default(false) @map("no_show")
  version      Int               @default(1)
  createdAt    DateTime          @default(dbgenerated("statement_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @default(dbgenerated("statement_timestamp()")) @map("updated_at") @db.Timestamptz(6)
  addresses    CustomerAddress[]
  orders       Order[]

  @@map("customers")
}

/// Immutable saved address; orders keep their own snapshot (step 73).
model CustomerAddress {
  id         String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  customerId String       @map("customer_id") @db.Uuid
  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  areaId     String       @map("area_id") @db.Uuid
  area       DeliveryArea @relation(fields: [areaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  type       String       @db.VarChar(16)
  building   String       @db.VarChar(150)
  unit       String?      @db.VarChar(50)
  street     String?      @db.VarChar(150)
  makani     String?      @db.VarChar(10)
  notes      String?      @db.VarChar(500)
  createdAt  DateTime     @default(dbgenerated("statement_timestamp()")) @map("created_at") @db.Timestamptz(6)

  @@index([customerId, createdAt(sort: Desc), id(sort: Desc)], map: "customer_addresses_customer")
  @@map("customer_addresses")
}

model Brand {
  id          String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name        String         @db.VarChar(150)
  slug        String         @unique @db.VarChar(150)
  logoKey     String?        @map("logo_key") @db.VarChar(512)
  description String         @default("")
  active      Boolean        @default(false)
  sortOrder   Int            @default(0) @map("sort_order")
  seo         Json           @default("{}")
  version     Int            @default(1)
  deletedAt   DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime       @default(dbgenerated("statement_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @default(dbgenerated("statement_timestamp()")) @map("updated_at") @db.Timestamptz(6)
  products    Product[]
  redirects   SlugRedirect[]

  @@map("brands")
}

model Category {
  id        String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String         @db.VarChar(150)
  slug      String         @unique @db.VarChar(150)
  imageKey  String?        @map("image_key") @db.VarChar(512)
  active    Boolean        @default(false)
  sortOrder Int            @default(0) @map("sort_order")
  seo       Json           @default("{}")
  version   Int            @default(1)
  deletedAt DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime       @default(dbgenerated("statement_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @default(dbgenerated("statement_timestamp()")) @map("updated_at") @db.Timestamptz(6)
  products  Product[]
  redirects SlugRedirect[]

  @@map("categories")
}

model Product {
  id                  String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name                String    @db.VarChar(150)
  slug                String    @unique @db.VarChar(150)
  brandId             String    @map("brand_id") @db.Uuid
  categoryId          String    @map("category_id") @db.Uuid
  brand               Brand     @relation(fields: [brandId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  category            Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  type                String    @db.VarChar(16)
  puffCount           Int?      @map("puff_count")
  status              String    @default("draft") @db.VarChar(16)
  basePriceFils       BigInt    @map("base_price_fils")
  compareAtPriceFils  BigInt?   @map("compare_at_price_fils")
  taxTreatmentRef     String?   @map("tax_treatment_ref") @db.VarChar(100)
  taxTreatmentVersion Int?      @map("tax_treatment_version")
  specs               Json      @default("{}")
  description         String    @default("")
  seo                 Json      @default("{}")
  isNew               Boolean   @default(false) @map("is_new")
  version             Int       @default(1)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(dbgenerated("statement_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(dbgenerated("statement_timestamp()")) @map("updated_at") @db.Timestamptz(6)

  options   ProductOption[]
  variants  Variant[]
  media     MediaAsset[]
  images    ProductImage[]
  orderItems OrderItem[]
  redirects SlugRedirect[]
  search    ProductSearch?

  @@index([brandId], map: "products_brand")
  @@index([categoryId], map: "products_category")
  @@map("products")
}

model ProductOption {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  product       Product  @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  name          String   @db.VarChar(64)
  allowedValues Json     @map("allowed_values")
  sortOrder     Int      @default(0) @map("sort_order")
  version       Int      @default(1)
  createdAt     DateTime @default(dbgenerated("statement_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(dbgenerated("statement_timestamp()")) @map("updated_at") @db.Timestamptz(6)

  @@unique([productId, name])
  @@map("product_options")
}

model Variant {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  product           Product  @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sku               String   @unique @db.VarChar(64)
  attributes        Json     @default("{}")
  /// Generated by PostgreSQL from normalized attributes; callers cannot supply it.
  optionSignature   String   @default(dbgenerated()) @map("option_signature")
  priceOverrideFils BigInt?  @map("price_override_fils")
  stockOnHand       Int      @default(0) @map("stock_on_hand")
  lowStockThreshold Int      @default(0) @map("low_stock_threshold")
  active            Boolean  @default(false)
  isDefault         Boolean  @default(false) @map("is_default")
  version           Int      @default(1)
  createdAt         DateTime @default(dbgenerated("statement_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(dbgenerated("statement_timestamp()")) @map("updated_at") @db.Timestamptz(6)

  stockMovements StockMovement[]
  orderItems     OrderItem[]

  @@unique([productId, optionSignature])
  @@index([productId, active], map: "variants_availability")
  @@map("variants")
}

/// Append-only stock ledger (step 46). Inserting a row applies `delta` to the variant in the same
/// statement (DB trigger) and records `balanceAfter`; it is the only way to change stock.
model StockMovement {
  id           String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  variantId    String     @map("variant_id") @db.Uuid
  variant      Variant    @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  delta        Int
  /// Set by the database trigger; any value supplied by a caller is overwritten.
  balanceAfter Int        @map("balance_after")
  reason       String     @db.VarChar(24)
  note         String?    @db.VarChar(500)
  commandId    String     @map("command_id") @db.VarChar(128)
  effect       String     @default("adjust") @db.VarChar(32)
  actorId      String?    @map("actor_id") @db.Uuid
  actor        StaffUser? @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Set for a sale: the order that took the stock (step 76).
  orderId      String?    @map("order_id") @db.Uuid
  order        Order?     @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdAt    DateTime   @default(dbgenerated("statement_timestamp()")) @map("created_at") @db.Timestamptz(6)

  @@unique([commandId, variantId, effect])
  @@index([variantId, createdAt, id], map: "stock_movements_variant")
  @@map("stock_movements")
}

model ProductImage {
  id           String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  productId    String     @map("product_id") @db.Uuid
  product      Product    @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assetKey     String     @map("asset_key") @db.VarChar(512)
  isPrimary    Boolean    @default(false) @map("is_primary")
  sortOrder    Int        @default(0) @map("sort_order")
  alt          String     @default("") @db.VarChar(500)
  width        Int
  height       Int
  mime         String     @db.VarChar(32)
  /// The processed (ready) media asset this image shows (step 50).
  mediaAssetId String     @unique @map("media_asset_id") @db.Uuid
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  version      Int        @default(1)
  createdAt    DateTime   @default(dbgenerated("statement_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(dbgenerated("statement_timestamp()")) @map("updated_at") @db.Timestamptz(6)

  @@unique([productId, assetKey])
  @@index([productId, sortOrder, id], map: "product_images_order")
  @@map("product_images")
}

/// Search projection (step 60): derived text and tsvector per product, written only by
/// database triggers. The GIN indexes (tsvector, trigram) are defined in the migration.
model ProductSearch {
  productId  String                  @id @map("product_id") @db.Uuid
  product    Product                 @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  searchText String                  @map("search_text")
  document   Unsupported("tsvector")
  updatedAt  DateTime                @default(dbgenerated("statement_timestamp()")) @map("updated_at") @db.Timestamptz(6)

  @@map("product_search")
}

model SlugRedirect {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  entityType String    @map("entity_type") @db.VarChar(16)
  oldSlug    String    @map("old_slug") @db.VarChar(150)
  brandId    String?   @map("brand_id") @db.Uuid
  categoryId String?   @map("category_id") @db.Uuid
  productId  String?   @map("product_id") @db.Uuid
  brand      Brand?    @relation(fields: [brandId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  product    Product?  @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  version    Int       @default(1)
  createdAt  DateTime  @default(dbgenerated("statement_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(dbgenerated("statement_timestamp()")) @map("updated_at") @db.Timestamptz(6)

  @@unique([entityType, oldSlug])
  @@index([brandId], map: "redirects_brand")
  @@index([categoryId], map: "redirects_category")
  @@index([productId], map: "redirects_product")
  @@map("slug_redirects")
}

/// Quarantine upload record (step 48). Bytes are untrusted until processing (step 49) marks the
/// asset `ready`; only ready assets may become product images.
model MediaAsset {
  id                 String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  productId          String    @map("product_id") @db.Uuid
  product            Product   @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  uploadedBy         String    @map("uploaded_by") @db.Uuid
  uploader           StaffUser @relation(fields: [uploadedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  quarantineKey      String    @unique @map("quarantine_key") @db.VarChar(512)
  declaredType       String    @map("declared_type") @db.VarChar(32)
  declaredBytes      Int       @map("declared_bytes")
  state              String    @default("pending") @db.VarChar(16)
  observedBytes      Int?      @map("observed_bytes")
  observedType       String?   @map("observed_type") @db.VarChar(32)
  observedEtag       String?   @map("observed_etag") @db.VarChar(128)
  width              Int?
  height             Int?
  sha256             String?   @db.Char(64)
  derivativeKeys     Json      @default("{}") @map("derivative_keys")
  error              String?   @db.VarChar(64)
  uploadExpiresAt    DateTime  @map("upload_expires_at") @db.Timestamptz(6)
  /// When the private quarantine original was deleted (cleanup, step 49).
  quarantinePurgedAt DateTime? @map("quarantine_purged_at") @db.Timestamptz(6)
  version            Int       @default(1)
  createdAt          DateTime  @default(dbgenerated("statement_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(dbgenerated("statement_timestamp()")) @map("updated_at") @db.Timestamptz(6)

  image ProductImage?

  @@index([productId, createdAt, id], map: "media_assets_product")
  @@map("media_assets")
}

/// An order with its own copy of customer, address, area, coupon and totals (step 73).
/// Never deleted; contents are fixed once processing starts.
model Order {
  id                           String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Sequential display number assigned by the database; gaps are normal.
  orderNumber                  BigInt               @unique @default(autoincrement()) @map("order_number")
  customerId                   String               @map("customer_id") @db.Uuid
  customer                     Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  status                       String               @default("pending") @db.VarChar(20)
  source                       String               @db.VarChar(16)
  createdBy                    String?              @map("created_by") @db.Uuid
  creator                      StaffUser?           @relation("OrderCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  customerName                 String               @map("customer_name") @db.VarChar(100)
  customerPhoneE164            String               @map("customer_phone_e164") @db.VarChar(16)
  areaId                       String               @map("area_id") @db.Uuid
  area                         DeliveryArea         @relation(fields: [areaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  areaCode                     String               @map("area_code") @db.VarChar(64)
  areaName                     String               @map("area_name") @db.VarChar(100)
  areaEmirate                  String               @map("area_emirate") @db.VarChar(16)
  addressType                  String               @map("address_type") @db.VarChar(16)
  addressBuilding              String               @map("address_building") @db.VarChar(150)
  addressUnit                  String?              @map("address_unit") @db.VarChar(50)
  addressStreet                String?              @map("address_street") @db.VarChar(150)
  addressMakani                String?              @map("address_makani") @db.VarChar(10)
  addressNotes                 String?              @map("address_notes") @db.VarChar(500)
  merchandiseSubtotalFils      BigInt               @map("merchandise_subtotal_fils")
  discountFils                 BigInt               @default(0) @map("discount_fils")
  deliveryFeeFils              BigInt               @map("delivery_fee_fils")
  totalFils                    BigInt               @map("total_fils")
  couponCode                   String?              @map("coupon_code") @db.VarChar(32)
  couponPercentBps             Int?                 @map("coupon_percent_bps")
  deliveryEtaText              String               @map("delivery_eta_text") @db.VarChar(500)
  areaVersion                  Int                  @map("area_version")
  deliveryConfigurationVersion Int                  @map("delivery_configuration_version")
  quoteFingerprint             String               @map("quote_fingerprint") @db.VarChar(64)
  ageConfirmedAt               DateTime             @map("age_confirmed_at") @db.Timestamptz(6)
  agePolicyVersion             String               @map("age_policy_version") @db.VarChar(64)
  codStatus                    String               @default("pending") @map("cod_status") @db.VarChar(16)
  collectedAmountFils          BigInt?              @map("collected_amount_fils")
  collectedAt                  DateTime?            @map("collected_at") @db.Timestamptz(6)
  collectedBy                  String?              @map("collected_by") @db.Uuid
  collector                    StaffUser?           @relation("OrderCollectedBy", fields: [collectedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  collectionReference          String?              @map("collection_reference") @db.VarChar(100)
  cancelReason                 String?              @map("cancel_reason") @db.VarChar(500)
  dispatchedAt                 DateTime?            @map("dispatched_at") @db.Timestamptz(6)
  deliveredAt                  DateTime?            @map("delivered_at") @db.Timestamptz(6)
  cancelledAt                  DateTime?            @map("cancelled_at") @db.Timestamptz(6)
  returnedAt                   DateTime?            @map("returned_at") @db.Timestamptz(6)
  creationScope                String               @map("creation_scope") @db.VarChar(64)
  creationKeyHash              Bytes                @map("creation_key_hash")
  creationPayloadHash          Bytes                @map("creation_payload_hash")
  confirmationHash             Bytes?               @map("confirmation_hash")
  confirmationExpiresAt        DateTime?            @map("confirmation_expires_at") @db.Timestamptz(6)
  version                      Int                  @default(1)
  createdAt                    DateTime             @default(dbgenerated("statement_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime             @default(dbgenerated("statement_timestamp()")) @map("updated_at") @db.Timestamptz(6)
  items                        OrderItem[]
  history                      OrderStatusHistory[]
  couponRedemption             CouponRedemption?
  stockMovements               StockMovement[]

  @@unique([creationScope, creationKeyHash], map: "orders_creation_key")
  @@index([customerId, createdAt(sort: Desc), id(sort: Desc)], map: "orders_customer")
  @@index([status, createdAt(sort: Desc), id(sort: Desc)], map: "orders_status")
  @@map("orders")
}

/// One merged line per variant, with what the variant was when sold.
model OrderItem {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  productId      String   @map("product_id") @db.Uuid
  product        Product  @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  variantId      String   @map("variant_id") @db.Uuid
  variant        Variant  @relation(fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  productName    String   @map("product_name") @db.VarChar(150)
  productSlug    String   @map("product_slug") @db.VarChar(150)
  brandName      String   @map("brand_name") @db.VarChar(150)
  categoryName   String   @map("category_name") @db.VarChar(150)
  sku            String   @db.VarChar(64)
  attributes     Json     @default("{}")
  productVersion Int      @map("product_version")
  variantVersion Int      @map("variant_version")
  unitPriceFils  BigInt   @map("unit_price_fils")
  quantity       Int
  subtotalFils   BigInt   @map("subtotal_fils")
  discountFils   BigInt   @default(0) @map("discount_fils")
  totalFils      BigInt   @map("total_fils")
  createdAt      DateTime @default(dbgenerated("statement_timestamp()")) @map("created_at") @db.Timestamptz(6)

  @@unique([orderId, variantId], map: "order_items_variant_key")
  @@index([variantId], map: "order_items_variant")
  @@map("order_items")
}

/// Append-only: every status an order has had, and why.
model OrderStatusHistory {
  id           String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  seq          BigInt     @unique @default(autoincrement())
  orderId      String     @map("order_id") @db.Uuid
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fromStatus   String?    @map("from_status") @db.VarChar(20)
  toStatus     String     @map("to_status") @db.VarChar(20)
  reason       String?    @db.VarChar(500)
  actorKind    String     @map("actor_kind") @db.VarChar(16)
  actorId      String?    @map("actor_id") @db.Uuid
  actor        StaffUser? @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  commandId    String     @map("command_id") @db.VarChar(128)
  orderVersion Int        @map("order_version")
  createdAt    DateTime   @default(dbgenerated("statement_timestamp()")) @map("created_at") @db.Timestamptz(6)

  @@unique([orderId, commandId], map: "order_status_history_command")
  @@index([orderId, seq], map: "order_status_history_order")
  @@map("order_status_history")
}

/// One accepted command key and the answer to replay for it (step 74). Hashes only.
model IdempotencyRecord {
  replayCookieMaterial  Bytes?    @map("replay_cookie_material")
  replayCookieExpiresAt DateTime? @map("replay_cookie_expires_at") @db.Timestamptz(6)
  id                    String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  scope                 String    @db.VarChar(64)
  keyHash               Bytes     @map("key_hash")
  payloadHash           Bytes     @map("payload_hash")
  response              Json?
  resourceType          String?   @map("resource_type") @db.VarChar(32)
  resourceId            String?   @map("resource_id") @db.Uuid
  createdAt             DateTime  @default(dbgenerated("statement_timestamp()")) @map("created_at") @db.Timestamptz(6)
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz(6)

  @@unique([scope, keyHash], map: "idempotency_records_key")
  @@index([expiresAt], map: "idempotency_records_expiry")
  @@map("idempotency_records")
}


/// Staff notification content, written once per source event and type (step 78). Immutable.
model Notification {
  id            String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  sourceEventId String                @map("source_event_id") @db.Uuid
  type          String                @db.VarChar(64)
  title         String                @db.VarChar(150)
  body          String                @db.VarChar(500)
  link          String?               @db.VarChar(300)
  createdAt     DateTime              @default(dbgenerated("statement_timestamp()")) @map("created_at") @db.Timestamptz(6)
  receipts      NotificationReceipt[]

  @@unique([sourceEventId, type], map: "notifications_source")
  @@index([createdAt], map: "notifications_created")
  @@map("notifications")
}

/// One per recipient; `readAt` is that user's own read flag.
model NotificationReceipt {
  notificationId String       @map("notification_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user           StaffUser    @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  deliveredAt    DateTime     @default(dbgenerated("statement_timestamp()")) @map("delivered_at") @db.Timestamptz(6)
  readAt         DateTime?    @map("read_at") @db.Timestamptz(6)

  @@id([notificationId, userId])
  @@index([userId, readAt, notificationId], map: "notification_receipts_inbox")
  @@map("notification_receipts")
}
