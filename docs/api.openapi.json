{
  "openapi": "3.0.3",
  "info": {
    "title": "Iqos Haven — implemented API contracts",
    "version": "0.0.0",
    "description": "Implemented health, password-reset and invitation contracts. Browser identity commands require the configured admin Origin and JSON bodies; responses are no-store. Identity UI is roadmap step 37."
  },
  "paths": {
    "/v1/admin/staff/invitations": {
      "post": {
        "operationId": "staffInvite",
        "security": [{ "adminSession": [] }],
        "description": "Requires staff.manage; approved recipient/name/role stored by the server. Resend revokes the prior pending invitation.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/InvitationRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Invitation issued; secret delivered only by worker email",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InvitationResponse" }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "401": {
            "description": "Session required",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "403": {
            "description": "Permission or Origin denied",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "409": {
            "description": "Account already exists",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "503": {
            "description": "Invitation configuration or limiter unavailable",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          }
        }
      }
    },
    "/v1/admin/staff/invitations/revoke": {
      "post": {
        "operationId": "staffInviteRevoke",
        "security": [{ "adminSession": [] }],
        "description": "Requires staff.manage; idempotent for nonexistent/accepted/revoked invitations.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InvitationRevokeRequest"
              }
            }
          }
        },
        "responses": {
          "204": { "description": "Pending invitation revoked" },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "401": {
            "description": "Session required",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "403": {
            "description": "Permission or Origin denied",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "503": {
            "description": "Limiter unavailable",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          }
        }
      }
    },
    "/v1/auth/invite/accept": {
      "post": {
        "operationId": "staffInviteAccept",
        "description": "Single-use 24-hour invitation. Recipient, name and role cannot be supplied by the invitee. Existing accounts are never overwritten/reactivated.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InvitationAcceptRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Account created with the stored role; no auto-login"
          },
          "400": {
            "description": "Invalid invitation or password",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "403": {
            "description": "Origin denied",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "429": {
            "description": "Rate limited; Retry-After set",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "503": {
            "description": "Invitation configuration or limiter unavailable",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          }
        }
      }
    },
    "/v1/auth/forgot": {
      "post": {
        "operationId": "passwordResetRequest",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ForgotRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted, irrespective of account existence",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ForgotResponse" }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "403": {
            "description": "Origin denied",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "415": {
            "description": "JSON required",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "429": {
            "description": "Rate limited; Retry-After set",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "503": {
            "description": "Reset configuration or authoritative limiter unavailable",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          }
        }
      }
    },
    "/v1/auth/reset": {
      "post": {
        "operationId": "passwordResetConsume",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ResetRequest" }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Password changed; all sessions and sibling links revoked; no auto-login"
          },
          "400": {
            "description": "Invalid request, link or password",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "403": {
            "description": "Origin denied",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "415": {
            "description": "JSON required",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "429": {
            "description": "Rate limited; Retry-After set",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          },
          "503": {
            "description": "Reset configuration or authoritative limiter unavailable",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
              }
            }
          }
        }
      }
    },
    "/v1/health/live": {
      "get": {
        "operationId": "healthLive",
        "responses": {
          "200": {
            "description": "Process alive",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LivenessResponse" }
              }
            }
          }
        }
      }
    },
    "/v1/health/ready": {
      "get": {
        "operationId": "healthReady",
        "responses": {
          "200": {
            "description": "Ready or queue degraded",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ReadinessResponse" }
              }
            }
          },
          "503": {
            "description": "Database unavailable",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ReadinessResponse" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LivenessResponse": {
        "type": "object",
        "properties": { "status": { "type": "string", "enum": ["ok"] } },
        "required": ["status"],
        "additionalProperties": false
      },
      "ReadinessResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["ok", "degraded", "down"] },
          "checks": {
            "type": "object",
            "properties": {
              "database": { "type": "string", "enum": ["up", "down"] },
              "queue": { "type": "string", "enum": ["up", "down"] }
            },
            "required": ["database", "queue"],
            "additionalProperties": false
          }
        },
        "required": ["status", "checks"],
        "additionalProperties": false
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "requestId": { "type": "string" },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": { "type": "string", "maxLength": 200 },
                    "message": { "type": "string", "maxLength": 200 }
                  },
                  "required": ["path", "message"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["code", "message", "requestId", "fields"],
            "additionalProperties": false
          }
        },
        "required": ["error"],
        "additionalProperties": false
      },
      "ForgotRequest": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "minLength": 1, "maxLength": 320 }
        },
        "required": ["email"],
        "additionalProperties": false
      },
      "ForgotResponse": {
        "type": "object",
        "properties": { "accepted": { "type": "boolean", "enum": [true] } },
        "required": ["accepted"],
        "additionalProperties": false
      },
      "ResetRequest": {
        "type": "object",
        "properties": {
          "token": { "type": "string", "minLength": 1, "maxLength": 200 },
          "password": { "type": "string", "minLength": 1, "maxLength": 1024 }
        },
        "required": ["token", "password"],
        "additionalProperties": false
      },
      "InvitationRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "name": { "type": "string", "minLength": 1, "maxLength": 100 },
          "role": { "type": "string", "enum": ["owner", "staff"] }
        },
        "required": ["email", "name", "role"],
        "additionalProperties": false
      },
      "InvitationResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": ["id", "expiresAt"],
        "additionalProperties": false
      },
      "InvitationRevokeRequest": {
        "type": "object",
        "properties": {
          "invitationId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": ["invitationId"],
        "additionalProperties": false
      },
      "InvitationAcceptRequest": {
        "type": "object",
        "properties": {
          "token": { "type": "string", "minLength": 1, "maxLength": 200 },
          "password": { "type": "string", "minLength": 1, "maxLength": 1024 }
        },
        "required": ["token", "password"],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "adminSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-ih_admin"
      }
    }
  }
}
