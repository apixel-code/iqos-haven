# Copy to .env for LOCAL development. See docs/environment.md for supported vs reserved variables.
NODE_ENV=development
APP_ENV=development
LOG_LEVEL=debug

# --- PostgreSQL ---
# Runtime role (least privilege) used by api/worker
DATABASE_URL=postgres://ih_app:ih_app_dev@localhost:5432/iqos_haven
# Owner role used only by migrations
DATABASE_MIGRATION_URL=postgres://ih_owner:ih_owner_dev@localhost:5432/iqos_haven
# Integration tests
DATABASE_TEST_URL=postgres://ih_test:ih_test_dev@localhost:5432/iqos_haven_test

# --- Queue Redis (noeviction) ---
QUEUE_REDIS_URL=redis://localhost:6379
# Optional cache Redis (replicated profile only; not deployed in the budget profile).
# Must be a different instance from QUEUE_REDIS_URL; it may evict, the queue must not.
# CACHE_REDIS_URL=

# --- Object storage (api/worker). Local MinIO; production provider is BI-06 ---
# Least-privilege service user created by minio-init (never the MinIO root account).
S3_ENDPOINT=http://localhost:9000
# Browser-facing endpoint for presigned uploads when the service endpoint is internal (BI-06).
# S3_PUBLIC_ENDPOINT=
S3_REGION=me-central-1
S3_ACCESS_KEY=ih_service
S3_SECRET_KEY=ih_service_dev_secret
S3_FORCE_PATH_STYLE=true
S3_BUCKET_QUARANTINE=ih-quarantine
S3_BUCKET_MEDIA=ih-media
S3_BUCKET_REPORTS=ih-reports

# --- Password hashing (argon2id). Tune on the production runtime: pnpm identity:benchmark ---
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# --- Browser origins and rate limits (step 32) ---
# State-changing cookie requests must send one of these Origins (comma lists; https outside dev).
ADMIN_ORIGINS=http://localhost:8081
STOREFRONT_ORIGINS=http://localhost:8080
# budget = local limiter in the single API process; replicated = shared CACHE_REDIS_URL limiter.
RATE_LIMIT_PROFILE=budget
# Keyed-hash secret for limiter keys (>= 32 chars); required when replicated, same on all replicas.
# RATE_LIMIT_KEY_SECRET=
RATE_LIMIT_LOCAL_MAX_KEYS=50000
RATE_LIMIT_MAX_REPLICAS=1

# --- Catalogue read cache (step 52). API process owns it; TTL is capped at 60 s. ---
CATALOG_CACHE_TTL_SECONDS=60
CATALOG_CACHE_MAX_ENTRIES=2000
CATALOG_CACHE_MAX_BYTES=33554432
CATALOG_CACHE_MAX_CONCURRENT_MISSES=8
CATALOG_CACHE_MAX_QUEUED_MISSES=200

# --- Age gate (step 55, ADR 0024). Generate a key pair: pnpm age:keygen ---
# Verifiers (API and storefront): "kid:base64urlPublicKey", comma separated for rotation.
AGE_TICKET_PUBLIC_KEYS=
# Policy version shoppers affirm (BI-04). "unapproved" is refused in production.
AGE_POLICY_VERSION=unapproved
# Storefront only. Never give the private key to the API, worker or admin.
# AGE_TICKET_KEY_ID=
# AGE_TICKET_PRIVATE_KEY=
# Remembered acceptance in days (30 proposed; approved value is BI-04; hard cap 30).
AGE_TICKET_TTL_DAYS=30
# Minutes an under-age answer keeps the device on the restricted page (placeholder; BI-04).
AGE_RESTRICTED_MINUTES=15

# --- Private service auth (step 26) ---
# API: callers it accepts, "service:keyId:base64urlSecret" (>= 32 bytes), comma separated.
# Generate a secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_SERVICE_KEYS=
# Worker/storefront: own signing identity (all three or none). The worker uses it with
# API_INTERNAL_URL to invalidate the API catalogue cache; required in staging/production.
# Without it locally, invalidation effects are skipped and the cache TTL bounds staleness.
# INTERNAL_SERVICE_ID=worker
# INTERNAL_SERVICE_KEY_ID=k1
# INTERNAL_SERVICE_KEY=

# --- Email (worker). Provider/sender/recipients are BI-07; locally Mailpit (http://localhost:8025) ---
# Sending stays off unless exactly "true". development/test may only target a local sink.
EMAIL_SEND_ENABLED=false
# smtp (local Mailpit / relay) or resend (ADR 0004; production provider)
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@iqoshaven.local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# Resend: secret API key from the Resend dashboard (never commit a real key). Tests use a local stub URL.
# RESEND_API_KEY=
# RESEND_API_URL=https://api.resend.com
# Comma list of addresses or @domains; mandatory in staging (and for Resend in development).
EMAIL_RECIPIENT_ALLOWLIST=
# Integration tests only: Mailpit HTTP API
MAILPIT_URL=http://localhost:8025

# --- Ports ---
API_PORT=4000
API_HOST=127.0.0.1
STOREFRONT_PORT=3000
ADMIN_PORT=3001

# --- Storefront/worker → API (server-side only) ---
API_INTERNAL_URL=http://localhost:4000

# Optional bounded foundation defaults
DATABASE_POOL_MAX=10
WORKER_CONCURRENCY=4
WORKER_STARTUP_TIMEOUT_MS=15000

# Password reset: API + worker share an independent key ring, never internal-auth/session keys.
# Set via secret manager: reset:<keyId>:<base64url secret of >=32 random bytes>, comma-separated.
# First entry issues new links; retain previous entries until pending 30-minute links expire.
# Empty keys disable reset endpoints (503); do not use a committed/default key.
PASSWORD_RESET_KEYS=
PASSWORD_RESET_ORIGIN=http://localhost:8081

# Staff invitation: independent API/worker purpose key ring; empty disables issue/accept (503).
# Set via secret manager: invite:<keyId>:<base64url secret of >=32 random bytes>.
# Retain old keys through the 24-hour pending invitation expiry and rollout.
STAFF_INVITATION_KEYS=
STAFF_INVITATION_ORIGIN=http://localhost:8081
