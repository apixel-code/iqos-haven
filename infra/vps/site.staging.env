# Per-environment settings for infra/vps (copied to /opt/iqos-staging/site.env). Not secret.
IH_PROJECT=ih-staging
IH_HOST_STORE=staging.iqoshaven.com
IH_HOST_ADMIN=admin-staging.iqoshaven.com
IH_HOST_MEDIA=media-staging.iqoshaven.com
IH_PORT_STORE=8180
IH_PORT_ADMIN=8181
IH_PORT_MEDIA=9100
IH_PORT_MAIL=8125
IH_SUBNET=172.30.50
# Staging sends every email to Mailpit on the server (nothing is delivered).
IH_MAILSINK=1
