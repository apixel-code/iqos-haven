{
  "name": "@ih/worker",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "analytics:backfill": "node dist/cli/rollup-backfill.main.js",
    "ops:test-alert": "node dist/cli/ops-test-alert.main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --exclude \"src/**/*.int.test.ts\"",
    "test:int": "vitest run --config vitest.int.config.ts"
  },
  "dependencies": {
    "@ih/application": "workspace:*",
    "@ih/config": "workspace:*",
    "@ih/contracts": "workspace:*",
    "@ih/db": "workspace:*",
    "@ih/domain": "workspace:*",
    "@ih/logger": "workspace:*",
    "@ih/platform": "workspace:*",
    "bullmq": "6.3.11",
    "ioredis": "6.0.0",
    "nodemailer": "10.2.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2",
    "tsx": "4.23.15"
  }
}
