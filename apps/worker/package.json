{
  "name": "@ih/worker",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --exclude \"src/**/*.int.test.ts\"",
    "test:int": "vitest run --config vitest.int.config.ts"
  },
  "dependencies": {
    "@ih/config": "workspace:*",
    "@ih/db": "workspace:*",
    "@ih/logger": "workspace:*",
    "bullmq": "6.3.11",
    "ioredis": "6.0.0",
    "@ih/contracts": "workspace:*",
    "@ih/application": "workspace:*",
    "@ih/domain": "workspace:*",
    "nodemailer": "10.0.16"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "@types/nodemailer": "8.0.2"
  }
}
