{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm --filter:*)",
      "Bash(pnpm db:migrate:*)",
      "Bash(pnpm db:generate:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm infra:up:*)",
      "Bash(pnpm test:int:*)",
      "Bash(pnpm exec:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose logs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Read(./.env.example)",
      "Read(./node_modules/turbo/docs/**)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(docker compose down:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm db:reset:*)",
      "Bash(curl:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Read(./**/dist/**)",
      "Read(./**/.next/**)",
      "Read(./**/.turbo/**)",
      "Read(./**/coverage/**)",
      "Read(./pnpm-lock.yaml)",
      "Read(./**/*.min.js)",
      "Read(./**/*.map)",
      "Bash(rm -rf:*)",
      "Bash(cat ./docs/prototypes/*)",
      "Bash(cat docs/prototypes/*)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.staging)",
      "Read(./.env.development)",
      "Read(./.env.test)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f PROGRESS.md ]; then echo '--- PROGRESS.md (top) ---'; sed -n '1,30p' PROGRESS.md; fi; git rev-parse --abbrev-ref HEAD 2>/dev/null | sed 's/^/branch: /'; git status --short 2>/dev/null | head -15"
          }
        ]
      }
    ]
  }
}
